PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require&channel_binding=require
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=12000
AI_RETRY_COUNT=2
AI_RETRY_BASE_DELAY_MS=700
# Optional fallback/legacy provider:
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_MODEL=qwen2.5:7b
# Primary Ollama endpoint.
OLLAMA_API_URL=http://localhost:11434
# Optional comma-separated fallback endpoints (useful for Docker).
# Example: http://ollama:11434,http://host.docker.internal:11434
OLLAMA_API_URLS=
TTS_API_URL=http://localhost:8880
# Optional comma-separated fallback endpoints for TTS (useful for Docker).
# Example: http://kokoro:8880,http://host.docker.internal:8880
TTS_API_URLS=
